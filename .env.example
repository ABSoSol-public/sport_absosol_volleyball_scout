# Kopie als .env ablegen und Werte anpassen — die .env ist git-ignoriert und
# enthält die echten Zugangsdaten; diese Vorlage enthält nur Platzhalter.

# ── Lokale Entwicklung (Docker Compose) ─────────────────────────────────────
DB_NAME=volleyscout
DB_USER=scout
DB_PASSWORD=scout
DB_ROOT_PASSWORD=root-change-me
DB_PORT=3306
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ── Synology: Allgemein ─────────────────────────────────────────────────────
SYNOLOGY_HOST=CHANGE-ME               # z. B. meine-nas.myds.me
PUBLIC_DOMAIN=CHANGE-ME               # öffentliche Domain der App (Reverse Proxy)

# ── Synology: MariaDB (Ziel-Deployment) ─────────────────────────────────────
SYNOLOGY_DB_HOST=CHANGE-ME            # Hostname/IP der Synology
SYNOLOGY_DB_PORT=3307                 # Netzwerk-Port der Synology-MariaDB (oft 3307)
SYNOLOGY_DB_NAME=volleyscout
SYNOLOGY_DB_USER=CHANGE-ME
SYNOLOGY_DB_PASSWORD=CHANGE-ME

# ── Synology: Freigegebener Ordner für Dateien (Scouts usw.) ────────────────
SYNOLOGY_SHARE_NAME=CHANGE-ME
SYNOLOGY_SHARE_USER=CHANGE-ME
SYNOLOGY_SHARE_PASSWORD=CHANGE-ME
