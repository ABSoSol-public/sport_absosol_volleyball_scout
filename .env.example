# Kopie als .env ablegen und Werte anpassen — die .env ist git-ignoriert und
# enthält die echten Zugangsdaten; diese Vorlage enthält nur Platzhalter.
# Es gibt bewusst keinen lokalen DB-Container: einzige Datenbank ist die
# MariaDB auf der Synology (lokal wie im NAS-Deployment).

# ── Ports (lokaler Stack) ───────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ── Synology: Allgemein ─────────────────────────────────────────────────────
SYNOLOGY_HOST=CHANGE-ME               # z. B. meine-nas.myds.me
PUBLIC_DOMAIN=CHANGE-ME               # öffentliche Domain der App (Reverse Proxy)

# ── Synology: MariaDB (einzige Datenbank, lokal + Deployment) ───────────────
SYNOLOGY_DB_HOST=CHANGE-ME            # von extern: DDNS-Name; auf der NAS selbst: LAN-IP
SYNOLOGY_DB_PORT=3307
SYNOLOGY_DB_NAME=volleyball
SYNOLOGY_DB_USER=CHANGE-ME
SYNOLOGY_DB_PASSWORD=CHANGE-ME

# ── Synology: Freigegebener Ordner für Dateien (Scouts usw.) ────────────────
SYNOLOGY_SHARE_NAME=CHANGE-ME
SYNOLOGY_SHARE_USER=CHANGE-ME
SYNOLOGY_SHARE_PASSWORD=CHANGE-ME

# ── Login/Session ───────────────────────────────────────────────────────────
VOLLEYSCOUT_SECRET_KEY=CHANGE-ME              # erzeugen mit: openssl rand -hex 32
VOLLEYSCOUT_COOKIE_SECURE=false               # true hinter HTTPS (NAS/Reverse Proxy)
